# ==============================================================================
# LeadPulse SaaS Platform - Production & Local Environment Template
# ==============================================================================

# 1. Server & Runtime Configuration
PORT=3001
NODE_ENV=production
JWT_SECRET=replace_with_a_long_random_64_char_secret_key

# 2. Public URLs & CORS (Comma-separated origins allowed to call the API)
PUBLIC_API_URL=https://api.yourdomain.com
FRONTEND_URL=https://yourdomain.com
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,http://localhost:5173

# 3. Firebase Admin SDK (Firestore Database)
# Option A (Cloud/Render/Railway/Docker): Paste the full minified JSON of serviceAccountKey.json
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-project-id","private_key":"..."}
# Option B (Local Dev / VPS): File path to serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
FIREBASE_PROJECT_ID=leadpulse-production

# 4. Google Places / Maps Discovery API (Optional - falls back to Headless Chromium Scraper)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# 5. Outbound Email Relay Defaults (Users can also configure custom SMTP inside the app)
RESEND_API_KEY=your_resend_api_key_here
DEFAULT_FROM_NAME="LeadPulse Growth Team"
DEFAULT_FROM_EMAIL="outreach@yourdomain.com"

# 6. SuperAdmin Security & Gateway Isolation
ADMIN_GATEWAY_SECRET=replace_with_your_super_secret_admin_gateway_token
ALLOWED_ADMIN_IPS=127.0.0.1,::1

# 7. Frontend (Vite) Build Variables (Place in client/.env or Vercel/Render Frontend Env)
VITE_API_URL=https://api.yourdomain.com
VITE_GOOGLE_CLIENT_ID=your_google_oauth_web_client_id.apps.googleusercontent.com
VITE_ADMIN_GATEWAY_SECRET=replace_with_your_super_secret_admin_gateway_token

# 8. Easy!Appointments & MySQL Booking Stack
EASYAPPOINTMENTS_URL=http://localhost:8088
EASYAPPOINTMENTS_PORT=8088
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=easyappointments
MYSQL_USER=user
MYSQL_PASSWORD=password
MYSQL_ROOT_PASSWORD=secret
VITE_EASYAPPOINTMENTS_URL=http://localhost:8088